<?xml version="1.0" encoding="utf-8"?>
<!-- AceMQ is not on nuget.org before 1.0; the mapping lets the AceMQ feed answer
     only for AceMq.* packages. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="acemq" value="https://acemq.org/nuget/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="acemq">
      <package pattern="AceMq.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
