# Every version this repository depends on, in one place.
#
# <LANG>_VERSION is the library release an image is built with and tagged as.
# <LANG>_EXAMPLES is the commit of acemq-<lang>-amqp-examples the tutorial code
# is fetched from at build time; it must be a commit whose own manifest pins
# that same release. `etc/check-pins.sh` checks both: every version is the
# newest release, and every examples commit pins it.
#
# Plain KEY=value lines, so the shell can source this and CI can pass each line
# to `docker build --build-arg` unchanged.

JAVA_VERSION=0.7.15
JAVA_EXAMPLES=63ca11aa14c14f70610778acbade5b4a716f0d16

PYTHON_VERSION=0.7.12
PYTHON_EXAMPLES=c65890bac66cdba312a0bf423fd695a1f070d644

RUBY_VERSION=0.7.14
RUBY_EXAMPLES=780c980c23ccb759571f2d030f7d95bafa65c24a

DOTNET_VERSION=0.7.13
DOTNET_EXAMPLES=7e1e90d9ccb320f4793b257cde92b7200f3e47fc

GO_VERSION=0.9.9
GO_EXAMPLES=9cfdf1c01409bbb9d9e11a3648f158910d955d96

# The broker every image carries, and the image each one is built on.
RABBITMQ_IMAGE=rabbitmq:4.3.6-management
