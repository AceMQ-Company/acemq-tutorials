# Every version this repository depends on, in one place.
#
# <LANG>_VERSION is the library release an image is built with and tagged as.
# <LANG>_EXAMPLES is the tag of acemq-<lang>-amqp-examples the tutorial code is
# fetched from at build time: examples-v<that release>, or -r<n> after it, which
# that repository puts on the commit it verified against the release and never
# moves. The build resolves it to its commit and records that in the image.
# `etc/check-pins.sh` checks both: every version is the newest release, and every
# examples tag names it, exists and pins it.
#
# .github/workflows/bump-pins.yml moves these every day, once both exist.
#
# Plain KEY=value lines, so the shell can source this and CI can pass each line
# to `docker build --build-arg` unchanged.

JAVA_VERSION=0.7.17
JAVA_EXAMPLES=examples-v0.7.17

PYTHON_VERSION=0.7.14
PYTHON_EXAMPLES=examples-v0.7.14

RUBY_VERSION=0.7.16
RUBY_EXAMPLES=examples-v0.7.16

DOTNET_VERSION=0.7.15
DOTNET_EXAMPLES=examples-v0.7.15

GO_VERSION=0.9.11
GO_EXAMPLES=examples-v0.9.11

# The broker every image carries, and the image each one is built on.
RABBITMQ_IMAGE=rabbitmq:4.3.6-management
